# Ignore everything by default
*

# But keep the gitignore file itself
!.gitignore

# Allow Git to enter subfolders
!*/

# Keep code files
!*.py
!*.ipynb
!*.R
!*.sh
!*.md

# Keep image files
!*.png
!*.jpg
!*.jpeg
!*.svg
!*.webp
!*.tif
!*.tiff

# Always ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore unnecessary folders
archive_code/
updated_gimic_package/
# Keep the local miMic implementation and its taxonomic-tree helper.
updated_miMic_test/*
!updated_miMic_test/miMic_test.py
!updated_miMic_test/tax_tree_create.py
