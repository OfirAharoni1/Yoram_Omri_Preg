# Ignore everything by default
*

# But keep the gitignore file itself
!.gitignore

# Allow Git to enter subfolders
!*/

# Keep code files
!*.py
!*.ipynb
!*.R
!*.sh
!*.md

# Keep image files
!*.png
!*.jpg
!*.jpeg
!*.svg
!*.webp
!*.tif
!*.tiff

# Always ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore unnecessary folders
archive_code/
updated_gimic_package/
updated_miMic_test/